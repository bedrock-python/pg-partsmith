{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa)",
      "Read(id_ecdsa)",
      "Read(id_ed25519)",
      "Read(.netrc)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.git-credentials)",
      "Read(secrets/**)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)"
    ]
  }
}
